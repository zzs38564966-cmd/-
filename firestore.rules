rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User root document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId)
                    && incoming().uid == request.auth.uid
                    && incoming().hasCompletedOnboarding is bool;
      allow update: if isOwner(userId) && isValidId(userId)
                    && incoming().uid == existing().uid;
      allow delete: if false;

      // User Budget Settings
      match /settings/budget {
        allow get: if isOwner(userId) && isValidId(userId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId)
                              && incoming().userId == request.auth.uid
                              && incoming().totalBudget is number
                              && incoming().totalBudget >= 0;
        allow delete: if isOwner(userId) && isValidId(userId);
      }

      // User Alert Rules & Preferences
      match /settings/alerts {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId)
                              && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(userId);
      }

      // User Connected Accounts & Authorization Settings
      match /settings/accounts {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId)
                              && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(userId);
      }

      // User Transactions
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(transactionId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(transactionId)
                      && incoming().userId == request.auth.uid
                      && incoming().amount is number
                      && incoming().amount > 0
                      && incoming().type in ['expense', 'income', 'transfer']
                      && incoming().date is string
                      && incoming().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                      && incoming().category is string
                      && incoming().channel is string;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(transactionId)
                      && incoming().userId == existing().userId
                      && incoming().amount is number
                      && incoming().amount > 0
                      && incoming().type in ['expense', 'income', 'transfer']
                      && incoming().date is string
                      && incoming().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                      && incoming().category is string
                      && incoming().channel is string;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(transactionId);
      }

      // User Import Logs
      match /importHistory/{importId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(importId)
                      && incoming().userId == request.auth.uid
                      && incoming().importedCount is number;
        allow update, delete: if isOwner(userId) && isValidId(userId);
      }

      // User Category Rules
      match /categoryRules/{ruleId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(ruleId)
                      && incoming().userId == request.auth.uid
                      && incoming().keyword is string
                      && incoming().keyword.size() > 0
                      && incoming().targetCategory is string
                      && incoming().targetType in ['expense', 'income', 'transfer']
                      && incoming().enabled is bool;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(ruleId)
                      && incoming().userId == existing().userId
                      && incoming().keyword is string
                      && incoming().targetCategory is string
                      && incoming().targetType in ['expense', 'income', 'transfer']
                      && incoming().enabled is bool;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(ruleId);
      }
    }
  }
}
